<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/session_card_active_background" />
            <stroke android:width="1dp" android:color="@color/session_card_active_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/session_card_background" />
            <stroke android:width="1dp" android:color="@color/session_card_stroke" />
        </shape>
    </item>
</selector>
